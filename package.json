{
  "name": "ios-chess",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:perft": "vitest run tests/perft.test.ts",
    "android": "npm run build && npx cap sync android && cd android && ./gradlew assembleDebug",
    "ios": "npm run build && npx cap sync ios && npx cap open ios"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/ios": "^7.6.8",
    "@capacitor/preferences": "^7.0.0"
  }
}
